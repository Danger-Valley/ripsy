{
  "name": "ripsy",
  "version": "0.2.0",
  "private": true,
  "workspaces": [
    "backend",
    "frontend/apps/*",
    "frontend/packages/*"
  ],
  "scripts": {
    "postinstall": "patch-package",
    "dev": "docker compose up -d redis && concurrently -n server,web -c cyan,green \"npm run dev:server\" \"npm run dev:web\"",
    "dev:server": "npm run dev -w @rps/backend",
    "dev:web": "npm run dev -w @rps/web",
    "dev:mobile": "npm run start -w @rps/mobile",
    "ios": "npm run ios -w @rps/mobile",
    "ios:beta": "npm run ios:beta -w @rps/mobile",
    "android": "npm run android -w @rps/mobile",
    "android:bundle": "npm run android:bundle -w @rps/mobile",
    "mobile:release:preflight": "npm run release:preflight -w @rps/mobile --",
    "dev:redis": "docker compose up redis",
    "build": "npm run typecheck -w @rps/backend && npm run build -w @rps/web && npm run typecheck -w @rps/mobile",
    "test": "npm run test:backend && npm run test:mobile",
    "test:backend": "npm test -w @rps/backend",
    "test:mobile": "npm test -w @rps/mobile -- --runInBand",
    "start:server": "npm start -w @rps/backend",
    "start:web": "npm start -w @rps/web"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "concurrently": "^9.2.1"
  },
  "dependencies": {
    "patch-package": "^8.0.1"
  }
}
