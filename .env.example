REDIS_URL=redis://127.0.0.1:6379
GAME_TTL_SECONDS=604800
RIPSY_REDIS_PREFIX=ripsy
SESSION_SECRET=replace-with-at-least-32-random-characters
SESSION_TTL_SECONDS=2592000
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3100
PUSH_INSTALLATION_TTL_SECONDS=7776000
# Set both values in Railway to enable FCM. Keep the service account JSON secret.
FIREBASE_PROJECT_ID=
FIREBASE_SERVICE_ACCOUNT_JSON=
NEXT_PUBLIC_GAME_WS_URL=ws://localhost:8080
NEXT_PUBLIC_GAME_HTTP_URL=http://localhost:8080/session

# Figure shop (Railway). Disabled until explicitly configured. Figure currencies
# and default prices come from the backend registry; admin overrides live in Redis.
# Do not put signing keys in NEXT_PUBLIC_*.
SHOP_ENABLED=false
SHOP_SOLANA_CLUSTER=devnet
SHOP_SOLANA_RPC_URL=https://api.devnet.solana.com
# Seeker Genesis Tokens only exist on mainnet, even while shop mints use devnet.
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
SHOP_TREASURY_ADDRESS=
SHOP_COLLECTION_ADDRESS=
SHOP_MINT_AUTHORITY_SECRET=
# RIPSY 001 is the free starter. Seeker fighter costs 1 SKR by default.
# Obsolete SHOP_FIG2_PRICE_LAMPORTS is ignored and can be removed from Railway.
SHOP_PUBLIC_ORIGIN=https://www.ripsy.fun
# Railway only. Public admin address, not a private key. Unset = admin disabled.
SHOP_ADMIN_WALLET=BJomJVCbjz22kd84scx7X3eqMTBmuqZ4nhiFR7Cvm6dh
# Optional Railway-only Jupiter key for admin USD rates. Keyless access works too.
# Never set NEXT_PUBLIC_JUPITER_API_KEY or include this in native builds.
JUPITER_API_KEY=
# Public link returned by GET /shop/catalog; replace with your HTTPS referral URL.
SHOP_SOLANA_MOBILE_STORE_URL=https://store.solanamobile.com/

# Web/Vercel. These public values are bundled at build time. Keep RPC credentials
# here browser-safe and restricted by origin; use a separate private backend RPC.
NEXT_PUBLIC_SHOP_API_URL=http://localhost:8080
NEXT_PUBLIC_PRIVY_APP_ID=
NEXT_PUBLIC_PRIVY_CLIENT_ID=
# Invitation installation destinations (Vercel only; HTTPS; never mobile-build env).
# Leave empty for the existing public TestFlight link and Android APK page.
# Replace iOS with App Store / Android with Google Play when actually published.
RIPSY_IOS_INSTALL_URL=
RIPSY_ANDROID_INSTALL_URL=
RIPSY_SEEKER_INSTALL_URL=
# Optional Google Play app-signing certificate(s), colon-separated SHA-256; APK
# release certificate is included by the association route without configuration.
ANDROID_APP_SHA256_CERT_FINGERPRINTS=
# Native app build settings (public identifiers, not secrets). Mobile npm scripts
# load only these two values from the root .env; server-only values are never sourced.
PRIVY_APP_ID=
PRIVY_CLIENT_ID=
NEXT_PUBLIC_SOLANA_DEVNET_RPC_URL=https://api.devnet.solana.com
NEXT_PUBLIC_SOLANA_DEVNET_WS_URL=wss://api.devnet.solana.com
NEXT_PUBLIC_SOLANA_MAINNET_RPC_URL=
NEXT_PUBLIC_SOLANA_MAINNET_WS_URL=
