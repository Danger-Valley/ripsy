REDIS_URL=redis://127.0.0.1:6379
GAME_TTL_SECONDS=604800
RIPSY_REDIS_PREFIX=ripsy
SESSION_SECRET=replace-with-at-least-32-random-characters
SESSION_TTL_SECONDS=2592000
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3100
PUSH_INSTALLATION_TTL_SECONDS=7776000
# Set both values in Railway to enable FCM. Keep the service account JSON secret.
FIREBASE_PROJECT_ID=
FIREBASE_SERVICE_ACCOUNT_JSON=
NEXT_PUBLIC_GAME_WS_URL=ws://localhost:8080
NEXT_PUBLIC_GAME_HTTP_URL=http://localhost:8080/session

# Figure shop (Railway). Disabled until explicitly configured. Prices are integer
# lamports: 1 SOL = 1000000000 lamports. Do not put signing keys in NEXT_PUBLIC_*.
SHOP_ENABLED=false
SHOP_SOLANA_CLUSTER=devnet
SHOP_SOLANA_RPC_URL=https://api.devnet.solana.com
# Seeker Genesis Tokens only exist on mainnet, even while shop mints use devnet.
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
SHOP_TREASURY_ADDRESS=
SHOP_COLLECTION_ADDRESS=
SHOP_MINT_AUTHORITY_SECRET=
# Figure 01 is the free starter and is deliberately not sold.
SHOP_FIG2_PRICE_LAMPORTS=
SHOP_PUBLIC_ORIGIN=https://www.ripsy.fun

# Web/Vercel. These public values are bundled at build time. Keep RPC credentials
# here browser-safe and restricted by origin; use a separate private backend RPC.
NEXT_PUBLIC_SHOP_API_URL=http://localhost:8080
NEXT_PUBLIC_PRIVY_APP_ID=
NEXT_PUBLIC_PRIVY_CLIENT_ID=
# Native app build settings (public identifiers, not secrets). Pass both to
# Xcode/Gradle when building iOS or Android.
PRIVY_APP_ID=
PRIVY_CLIENT_ID=
NEXT_PUBLIC_SOLANA_DEVNET_RPC_URL=https://api.devnet.solana.com
NEXT_PUBLIC_SOLANA_DEVNET_WS_URL=wss://api.devnet.solana.com
NEXT_PUBLIC_SOLANA_MAINNET_RPC_URL=
NEXT_PUBLIC_SOLANA_MAINNET_WS_URL=
